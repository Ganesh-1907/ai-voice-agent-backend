{
  "name": "ai-call-handling-backend",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS backend for AI call handling SaaS",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "lint": "tsc --noEmit",
    "drizzle:generate": "dotenv -e .env -- drizzle-kit generate --config=drizzle.config.ts",
    "drizzle:migrate": "dotenv -e .env -- drizzle-kit migrate --config=drizzle.config.ts",
    "drizzle:studio": "dotenv -e .env -- drizzle-kit studio --config=drizzle.config.ts",
    "drizzle:start": "npm run drizzle:studio",
    "drizzle:pull": "dotenv -e .env -- sh -c 'rm -rf drizzle/.pull && drizzle-kit pull --config=drizzle.config.ts --out drizzle/.pull --introspect-casing camel && cp drizzle/.pull/schema.ts src/database/schema.ts && if [ -f drizzle/.pull/relations.ts ]; then cp drizzle/.pull/relations.ts src/database/relations.ts; fi && rm -rf drizzle/.pull'",
    "drizzle:push": "dotenv -e .env -- drizzle-kit push --config=drizzle.config.ts",
    "drizzle:deploy": "npm run drizzle:generate && npm run drizzle:migrate",
    "seed": "dotenv -e .env -- tsx src/database/seed.ts",
    "seed:sample": "dotenv -e .env -- tsx src/database/sample-data.seed.ts",
    "seed:madhava-cars": "dotenv -e .env -- tsx src/database/madhava-cars.seed.ts",
    "test": "npm run build && node test/smoke-test.js",
    "test:watch": "tsx watch src/main.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.12",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.12",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.12",
    "@nestjs/swagger": "^7.4.2",
    "@types/ws": "^8.18.1",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "drizzle-orm": "^0.33.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.1",
    "postgres": "^3.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^10.0.0",
    "ws": "^8.20.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "dotenv-cli": "^7.4.4",
    "drizzle-kit": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
