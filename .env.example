NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
JWT_SECRET=replace-with-at-least-16-characters
JWT_EXPIRES_IN=7d
DATABASE_URL=postgres://user:password@localhost:5432/voice_agent
WEBHOOK_SECRET=replace-with-webhook-secret

# Exotel Voice v1
EXOTEL_API_KEY=replace-with-exotel-api-key
EXOTEL_API_TOKEN=replace-with-exotel-api-token
EXOTEL_SID=replace-with-exotel-account-sid
EXOTEL_SUBDOMAIN=api.in.exotel.com
EXOTEL_CALLER_ID=replace-with-exophone-or-virtual-number
EXOTEL_VIRTUAL_NUMBER=replace-with-exophone-or-virtual-number
CENTRAL_AGENT_NUMBER=replace-with-shared-ai-agent-number

# AI providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
GROQ_EMERGENCY_FALLBACK_MODEL=llama-3.1-8b-instant
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional messaging
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_SENDER_ID=
DEFAULT_COUNTRY_CODE=+91
